        registeredEmail = orgProfile.email;
        localStorage.setItem('sg_email', registeredEmail);
        localStorage.setItem('sg_notif_email', notificationEmail);
      }

      localStorage.setItem('sg_org_profile', JSON.stringify(orgProfile));
      closeProfileModal();
      window.renderAll();
      showToast('Organizational Profile Updated Successfully!', 'success');
    };

    window.handleDeleteOrganizationAccount = function() {
      const delKeyInput = document.getElementById('orgDeleteSecurityKey');
      const providedKey = delKeyInput ? delKeyInput.value.trim() : '';
      if (delKeyInput) delKeyInput.value = '';

      if (providedKey !== securityPasskey) {
        showToast('Invalid security key! Account deletion aborted.', 'error');
        if (delKeyInput) {
          delKeyInput.focus();
        }
        return;
      }

      if (confirm('CRITICAL WARNING: Are you absolutely certain you want to permanently delete this organizational account and wipe all database records?')) {
        localStorage.clear();
        alert('Organizational account and all associated terminal records have been permanently deleted.');
        location.reload();
      }
    };

    window.onload = async function() {
      setInterval(window.updateClock, 1000);
      window.updateClock();
      window.initHardwareBarcodeScanner();
      await window.checkBarcodeScannerConnection();

      const authGate = document.getElementById('appAuthGate');
      if (isTerminalAuthenticated) {
        if (authGate) authGate.classList.add('hidden');
      } else {
        if (authGate) authGate.classList.remove('hidden');
      }

      const settingsName = document.getElementById('settingsStoreName');
      const settingsCurr = document.getElementById('settingsCurrency');
      const settingsFooter = document.getElementById('settingsReceiptFooter');
      const settingsLock = document.getElementById('settingsAutoLock');

      if (settingsName) settingsName.value = orgProfile.name;
      if (settingsCurr) settingsCurr.value = currencySymbol;
      if (settingsFooter) settingsFooter.value = receiptFooterText;
      if (settingsLock) settingsLock.value = autoLockMinutes;

      window.renderAll();
    };
  </script>

