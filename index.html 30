        tbody.innerHTML = `<tr><td colspan="8" class="py-8 text-center text-slate-400 font-medium">Product catalog is currently empty. Click "Add Product Good" to get started.</td></tr>`;
        return;
      }
      catalogGoods.forEach((item, index) => {
        tbody.innerHTML += `
          <tr class="hover:bg-emerald-50/40">
            <td class="py-3 px-3 mono text-slate-700 font-semibold">${item.sku}</td>
            <td class="py-3 px-3 font-bold text-slate-900">${item.name} <span class="text-emerald-600 font-normal">[${item.size || 'Std'}]</span></td>
            <td class="py-3 px-3 text-center text-slate-700 mono">${item.capacity || 'N/A'}</td>
            <td class="py-3 px-3 text-center"><span class="px-2 py-0.5 bg-white border border-emerald-200 text-slate-700 rounded text-[10px] shadow-sm">${item.uom}</span></td>
            <td class="py-3 px-3 text-right mono text-emerald-600 font-bold">${item.taxRate !== undefined ? item.taxRate : 8.0}%</td>
            <td class="py-3 px-3 text-right mono">${item.totalStock}</td>
            <td class="py-3 px-3 text-right mono font-semibold text-emerald-600">${currencySymbol}${item.unitPrice.toFixed(2)}</td>
            <td class="py-3 px-3 text-center space-x-1">
              <button onclick="openAddProductModal(${index})" class="p-1.5 text-slate-500 hover:text-emerald-600 transition"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="deleteCatalogItem(${index})" class="p-1.5 text-slate-500 hover:text-rose-600 transition"><i class="fa-solid fa-trash"></i></button>
            </td>
          </tr>`;
      });
    };

    window.renderScaleScoreTable = function() {
      const tbody = document.getElementById('scaleScoreTableBody');
      const filter = document.getElementById('scaleScoreFilter') ? document.getElementById('scaleScoreFilter').value : 'all';
      if (!tbody) return;
      tbody.innerHTML = '';
      if (catalogGoods.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-slate-400 font-medium">No inventory items available.</td></tr>`;
        return;
      }
      catalogGoods.forEach(item => {
        const remaining = item.remainingStock !== undefined ? item.remainingStock : item.totalStock;
        const isReorder = remaining <= item.reorderPoint;
        if (filter === 'reorder' && !isReorder) return;
        if (filter === 'adequate' && isReorder) return;

        tbody.innerHTML += `
          <tr class="hover:bg-emerald-50/40">
            <td class="py-3 px-3"><div class="font-bold text-slate-900">${item.name} [${item.size}]</div><div class="text-[10px] text-slate-500 mono">${item.sku}</div></td>
            <td class="py-3 px-3 text-center mono text-slate-700">${item.capacity || 'N/A'}</td>
            <td class="py-3 px-3 text-center mono font-semibold text-slate-700">${item.totalStock} ${item.uom}</td>
            <td class="py-3 px-3 text-center mono font-bold ${isReorder ? 'text-amber-600' : 'text-emerald-600'}">${remaining} ${item.uom}</td>
            <td class="py-3 px-3 text-center">
              ${isReorder ? `<span class="px-2.5 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-[10px] font-bold"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Reorder Low Stock</span>` : `<span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded-full text-[10px] font-bold"><i class="fa-solid fa-check mr-1"></i>Stock Adequate</span>`}
            </td>
          </tr>`;
      });
    };

    window.renderStockAuditDoc = function() {
      const tbody = document.getElementById('auditLedgerTableBody');
      const totalUnitsEl = document.getElementById('auditDocTotalItems');
      const salesValEl = document.getElementById('auditDocSalesValue');
      const genDateEl = document.getElementById('auditDocGenDate');
      const storeDocName = document.getElementById('auditDocStoreName');
      const startDateVal = document.getElementById('auditStartDate') ? document.getElementById('auditStartDate').value : '';
      const endDateVal = document.getElementById('auditEndDate') ? document.getElementById('auditEndDate').value : '';
      const auditPeriodEl = document.getElementById('auditDocPeriod');

      if (storeDocName) storeDocName.innerText = `${orgProfile.name}`;
      if (genDateEl) genDateEl.innerText = new Date().toLocaleDateString();
      if (auditPeriodEl) {
        if (startDateVal || endDateVal) {
          auditPeriodEl.innerText = `${startDateVal || 'Start'} to ${endDateVal || 'End'}`;
        } else {
          auditPeriodEl.innerText = 'All Time';
        }
      }

      if (!tbody) return;
      tbody.innerHTML = '';

      let totalUnits = 0;
      let totalSales = 0;

      let filteredLogs = stockAuditLogs.filter(log => {
        if (!startDateVal && !endDateVal) return true;
        try {
          const logDate = new Date(log.timestamp);
          if (isNaN(logDate.getTime())) return true;
          const logDateString = logDate.toISOString().split('T')[0];
          if (startDateVal && logDateString < startDateVal) return false;
          if (endDateVal && logDateString > endDateVal) return false;
        } catch (e) {
          return true;
        }
        return true;
      });

      if (filteredLogs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-slate-400 font-medium">No activity audit logs recorded for the selected period.</td></tr>`;
      } else {
        filteredLogs.forEach(log => {
          totalUnits += log.qty;
          totalSales += log.totalVal;
          tbody.innerHTML += `
            <tr class="hover:bg-emerald-50/40">
              <td class="py-2.5 px-3 text-slate-500 mono text-[10px]">${log.timestamp}</td>
              <td class="py-2.5 px-3"><div class="font-bold text-slate-800">${log.name}</div><div class="text-[10px] text-slate-400 mono">${log.sku}</div></td>
              <td class="py-2.5 px-3 text-center"><span class="px-2 py-0.5 bg-emerald-50 text-emerald-700 border border-emerald-200 rounded text-[10px]"> ${log.type}</span></td>
              <td class="py-2.5 px-3 text-right font-extrabold text-emerald-600 mono">${currencySymbol}${log.totalVal.toFixed(2)}</td>
            </tr>`;
        });
      }
      if (totalUnitsEl) totalUnitsEl.innerText = `${totalUnits} units`;
      if (salesValEl) salesValEl.innerText = `${currencySymbol}${totalSales.toFixed(2)}`;
    };

    window.renderDashboardMetrics = function() {
      const volEl = document.getElementById('dashTotalVolume');
      const revEl = document.getElementById('dashTotalRevenue');
      const countEl = document.getElementById('dashCatalogCount');
      const dropdownList = document.getElementById('goodsDropdownItemsList');
      const countBadge = document.getElementById('dropdownCountBadge');

      let totalVol = 0;
      let totalRev = 0;
      stockAuditLogs.forEach(l => {
        totalVol += l.qty;
        totalRev += l.totalVal;
      });

      if (volEl) volEl.innerText = `${totalVol} units`;
      if (revEl) revEl.innerText = `${currencySymbol}${totalRev.toFixed(2)}`;
      if (countEl) countEl.innerText = catalogGoods.length;
      if (countBadge) countBadge.innerText = `${catalogGoods.length} Items`;

      if (dropdownList) {
        dropdownList.innerHTML = '';
        if (catalogGoods.length === 0) {
          dropdownList.innerHTML = `<div class="text-slate-400 text-center py-2">Catalog empty</div>`;
        } else {
          catalogGoods.forEach(g => {
            dropdownList.innerHTML += `<div class="flex justify-between items-center py-1 border-b border-emerald-100"><span class="font-semibold text-slate-800">${g.name} [${g.size}] (${g.capacity})</span><span class="mono text-emerald-600 font-bold">${currencySymbol}${g.unitPrice.toFixed(2)}</span></div>`;
          });
        }
      }
    };

    window.openAddProductModal = function(index = -1) {
      window.populateUomDropdown();
      const modal = document.getElementById('addProductModal');
      const title = document.getElementById('productModalTitle');
      const editIdx = document.getElementById('prodEditIndex');
      const sku = document.getElementById('prodSku');
      const name = document.getElementById('prodName');
      const size = document.getElementById('prodSize');
      const capacity = document.getElementById('prodCapacity');
      const customUom = document.getElementById('customUomInput');
      const taxRateInput = document.getElementById('prodTaxRate');
      const price = document.getElementById('prodPrice');
      const stock = document.getElementById('prodInitialStock');
      const reorder = document.getElementById('prodReorderPoint');

      if (!modal) return;
      editIdx.value = index;

      if (index >= 0) {
        const item = catalogGoods[index];
        title.innerText = 'Edit Product Good';
        sku.value = item.sku;
        name.value = item.name;
        size.value = item.size || '';
        capacity.value = item.capacity || '';
        customUom.value = item.uom;
        taxRateInput.value = item.taxRate !== undefined ? item.taxRate : 8.0;
        price.value = item.unitPrice;
        stock.value = item.totalStock;
        reorder.value = item.reorderPoint;
      } else {
        title.innerText = 'Add Product Good';
        sku.value = '';
        name.value = '';
        size.value = '';
        capacity.value = '';
        customUom.value = 'Pieces (pcs)';
        taxRateInput.value = '8.0';
        price.value = '';
        stock.value = '';
        reorder.value = '10';
      }

      modal.classList.remove('hidden');
    };

    window.closeAddProductModal = function() {
      const modal = document.getElementById('addProductModal');
      if (modal) modal.classList.add('hidden');
    };

    window.handleSaveProduct = function(event) {
      event.preventDefault();
      const editIdx = parseInt(document.getElementById('prodEditIndex').value);
      const sku = document.getElementById('prodSku').value.trim();
      const name = document.getElementById('prodName').value.trim();
      const size = document.getElementById('prodSize').value.trim() || 'Standard';
      const capacity = document.getElementById('prodCapacity').value.trim() || 'N/A';
      const uom = document.getElementById('customUomInput').value.trim() || 'Pieces (pcs)';
      const taxRate = parseFloat(document.getElementById('prodTaxRate').value || 8.0);
      const price = parseFloat(document.getElementById('prodPrice').value);
      const stock = parseInt(document.getElementById('prodInitialStock').value);
      const reorder = parseInt(document.getElementById('prodReorderPoint').value);

      if (editIdx >= 0) {
        catalogGoods[editIdx] = {
          ...catalogGoods[editIdx],
          sku,
          name,
          size,
          capacity,
          uom,
          taxRate,
          unitPrice: price,
          totalStock: stock,
          remainingStock: catalogGoods[editIdx].remainingStock !== undefined ? catalogGoods[editIdx].remainingStock : stock,
          reorderPoint: reorder
        };
        showToast('Product updated successfully!', 'success');
      } else {
        catalogGoods.push({
          sku,
          name,
          size,
          capacity,
          uom,
          taxRate,
          unitPrice: price,
          totalStock: stock,
          remainingStock: stock,
          reorderPoint: reorder
        });
        showToast('Product added to organizational catalog!', 'success');
      }

      localStorage.setItem('sg_catalog', JSON.stringify(catalogGoods));
      window.closeAddProductModal();
      window.renderAll();
    };

    window.deleteCatalogItem = function(index) {
      if (confirm('Are you sure you want to delete this product from the organizational catalog?')) {
        catalogGoods.splice(index, 1);
        localStorage.setItem('sg_catalog', JSON.stringify(catalogGoods));
        window.renderAll();
        showToast('Product deleted.', 'info');
      }
    };

    window.openSignInModal = function() {
      const modal = document.getElementById('signInModal');
      if (modal) modal.classList.remove('hidden');
    };

    window.closeSignInModal = function() {
      const modal = document.getElementById('signInModal');
      if (modal) modal.classList.add('hidden');
