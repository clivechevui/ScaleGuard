    let autoLockMinutes = localStorage.getItem('sg_autolock') || 'off';
    let isTerminalAuthenticated = localStorage.getItem('sg_authenticated') === 'true';

    // Organizational Profile State
    let orgProfile = JSON.parse(localStorage.getItem('sg_org_profile') || JSON.stringify({
      name: 'ScaleGuard Corp',
      department: 'Procurement & Materials Management',
      address: '123 Enterprise Blvd, Suite 400',
      email: notificationEmail,
      phone: '+1 (555) 019-2831',
      currency: '$'
    }));

    let systemNotifications = JSON.parse(localStorage.getItem('sg_notifications') || '[]');
    let isCatalogUnlocked = false;
    let isAuditUnlocked = false;

    // Hardware Barcode Scanner connection state
    let isScannerConnected = false;
    let barcodeBuffer = '';
    let barcodeTimer = null;

    // Comprehensive Units of Measurement Library
    let availableUnits = [
      'Kilograms (kg)', 'Grams (g)', 'Milligrams (mg)', 'Metric Tons (t)',
      'Liters (L)', 'Milliliters (ml)', 'Cubic Meters (m³)',
      'Pieces (pcs)', 'Bags (bag)', 'Packets (pkt)', 'Boxes (box)', 'Cartons (ctn)',
      'Bottles (btl)', 'Cans (can)', 'Rolls (roll)', 'Meters (m)', 'Centimeters (cm)',
      'Troy Ounces (ozt) [Gold/Precious]', 'Carats (ct) [Gemstones]'
    ];

    let receiptDesignSettings = JSON.parse(localStorage.getItem('sg_receipt_design') || JSON.stringify({
      headerText: orgProfile.name,
      taglineText: 'Organizational Terminal Receipt',
      addressText: orgProfile.address,
      phoneText: orgProfile.phone || '+1 (555) 019-2831',
      headerIcon: 'fa-scale-balanced',
      headerAlign: 'text-center',
      showTax: true,
      showSubtotal: true,
      fontFamily: 'font-mono',
      fontSize: 'text-[11px]',
      borderDash: 'border-dashed',
      paperTheme: 'thermal-paper',
      footerText: '*** Thank You for Shopping With Us ***',
      showBarcode: true,
      showQrCode: true,
      showOperator: true
    }));

    let catalogGoods = JSON.parse(localStorage.getItem('sg_catalog') || '[]');
    let activeCart = JSON.parse(localStorage.getItem('sg_active_cart') || '[]');
    let stockAuditLogs = JSON.parse(localStorage.getItem('sg_audit_logs') || '[]');

    window.showToast = function(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      if (!container) return;

      const toast = document.createElement('div');
      const colors = {
        success: 'bg-emerald-600 text-white border-emerald-500',
        error: 'bg-rose-600 text-white border-rose-500',
        info: 'bg-emerald-600 text-white border-emerald-500',
        warning: 'bg-amber-600 text-white border-amber-500'
      };

      toast.className = `p-3 rounded-xl border shadow-xl text-xs font-semibold flex items-center justify-between gap-2 transition-all duration-300 pointer-events-auto transform translate-y-2 opacity-0 ${colors[type] || colors.info}`;
      toast.innerHTML = `
        <div class="flex items-center gap-2">
          <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : type === 'error' ? 'fa-circle-xmark' : 'fa-circle-info'}"></i>
          <span>${message}</span>
        </div>
        <button onclick="this.parentElement.remove()" class="text-white/80 hover:text-white"><i class="fa-solid fa-xmark text-xs"></i></button>
      `;

      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 10);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    };

    window.pushSystemNotification = function(title, message) {
      const notif = {
        timestamp: new Date().toLocaleString(),
        title: title,
        message: message,
        emailTarget: notificationEmail
      };
      systemNotifications.unshift(notif);
      localStorage.setItem('sg_notifications', JSON.stringify(systemNotifications));
      window.updateNotificationBadge();
      window.renderNotificationCenter();
    };

    window.updateNotificationBadge = function() {
      const badge = document.getElementById('notificationBadgeCount');
      if (!badge) return;
      if (systemNotifications.length > 0) {
        badge.innerText = systemNotifications.length;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    };

    window.openNotificationCenterModal = function() {
      window.renderNotificationCenter();
      const modal = document.getElementById('notificationCenterModal');
      const targetDisp = document.getElementById('notifTargetDisplay');
      if (targetDisp) targetDisp.innerText = notificationEmail;
      if (modal) modal.classList.remove('hidden');
    };

    window.closeNotificationCenterModal = function() {
      const modal = document.getElementById('notificationCenterModal');
      if (modal) modal.classList.add('hidden');
    };

    window.renderNotificationCenter = function() {
      const listEl = document.getElementById('notificationCenterList');
      if (!listEl) return;
      listEl.innerHTML = '';
      if (systemNotifications.length === 0) {
        listEl.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">No system notifications or email alerts recorded yet.</p>`;
        return;
      }
      systemNotifications.forEach(n => {
        listEl.innerHTML += `
          <div class="p-3 bg-white border border-emerald-200 rounded-xl space-y-1 shadow-sm">
            <div class="flex justify-between items-center text-[10px] text-slate-500">
              <span class="font-bold text-emerald-600">${n.title}</span>
              <span class="mono">${n.timestamp}</span>
            </div>
            <p class="text-xs text-slate-800">${n.message}</p>
            <div class="text-[9px] text-slate-400">Dispatched to Email: <span class="text-emerald-600">${n.emailTarget}</span></div>
          </div>`;
      });
    };

    window.clearNotifications = function() {
      systemNotifications = [];
      localStorage.removeItem('sg_notifications');
      window.updateNotificationBadge();
      window.renderNotificationCenter();
      showToast('Notifications cleared.', 'info');
    };

    window.switchAuthGateMode = function(mode) {
      const signinForm = document.getElementById('gateSigninForm');
      const signupForm = document.getElementById('gateSignupForm');
      const tabSignin = document.getElementById('gateTabSignin');
      const tabSignup = document.getElementById('gateTabSignup');

      if (mode === 'signin') {
        signinForm.classList.remove('hidden');
        signupForm.classList.add('hidden');
        tabSignin.className = 'py-2 rounded-lg bg-emerald-600 text-white transition shadow-sm';
        tabSignup.className = 'py-2 rounded-lg text-slate-600 hover:text-slate-900 transition';
      } else {
        signinForm.classList.add('hidden');
        signupForm.classList.remove('hidden');
        tabSignup.className = 'py-2 rounded-lg bg-emerald-600 text-white transition shadow-sm';
        tabSignin.className = 'py-2 rounded-lg text-slate-600 hover:text-slate-900 transition';
      }
    };

    window.handleGateSignIn = function(event) {
      event.preventDefault();
      const emailInput = document.getElementById('gateSigninEmail').value.trim();
      const passInput = document.getElementById('gateSigninPassword').value.trim();
      const errEl = document.getElementById('gateSigninError');

      document.getElementById('gateSigninPassword').value = '';

      if (registeredEmail && emailInput.toLowerCase() === registeredEmail.toLowerCase() && passInput === registeredPassword) {
        isTerminalAuthenticated = true;
        localStorage.setItem('sg_authenticated', 'true');
        document.getElementById('appAuthGate').classList.add('hidden');
        showToast('Signed In Successfully!', 'success');
        window.renderAll();
      } else {
        if (errEl) errEl.classList.remove('hidden');
        showToast('Invalid email or password!', 'error');
      }
    };

    window.handleGateSignUp = function(event) {
      event.preventDefault();
      const email = document.getElementById('gateSignupEmail').value.trim();
      const password = document.getElementById('gateSignupPassword').value.trim();

      if (!email || !password) {
        showToast('Please fill in all registration fields.', 'warning');
        return;
      }

      registeredEmail = email;
      registeredPassword = password;
      notificationEmail = email;
      securityPasskey = password;

      // Automatically generate workspace name from email prefix
      const emailPrefix = email.split('@')[0];
      const autoOrgName = emailPrefix.charAt(0).toUpperCase() + emailPrefix.slice(1) + "'s Workspace";

      orgProfile.name = autoOrgName;
      orgProfile.email = email;

      localStorage.setItem('sg_email', registeredEmail);
      localStorage.setItem('sg_password', registeredPassword);
      localStorage.setItem('sg_notif_email', notificationEmail);
      localStorage.setItem('sg_passkey', securityPasskey);
      localStorage.setItem('sg_org_profile', JSON.stringify(orgProfile));
      localStorage.setItem('sg_authenticated', 'true');
      isTerminalAuthenticated = true;

      document.getElementById('gateSignupPassword').value = '';

      document.getElementById('appAuthGate').classList.add('hidden');
      showToast('Account Created Successfully & Terminal Launched!', 'success');
      window.pushSystemNotification('Account Created', `Workspace ${autoOrgName} registered successfully with alert email ${email}.`);
      window.renderAll();
    };

    window.playScanAudio = function() {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(1800, audioCtx.currentTime);
        gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.08);
      } catch (e) {
        // Audio fallback
      }
    };

    window.checkBarcodeScannerConnection = async function() {
      try {
        if (navigator.usb && navigator.usb.getDevices) {
          const devices = await navigator.usb.getDevices();
          isScannerConnected = devices.length > 0 || localStorage.getItem('sg_scanner_connected') === 'true';
        } else {
          isScannerConnected = localStorage.getItem('sg_scanner_connected') === 'true';
        }
      } catch (e) {
