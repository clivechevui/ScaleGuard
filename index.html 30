<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ScaleGuard POS & Enterprise Inventory Monitor</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
            }
          },
          keyframes: {
            shake: {
              '0%, 100%': { transform: 'translateX(0)' },
              '20%, 60%': { transform: 'translateX(-6px)' },
              '40%, 80%': { transform: 'translateX(6px)' }
            }
          },
          animation: {
            shake: 'shake 0.4s ease-in-out'
          }
        }
      }
    }
  </script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    
    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f8fafc; }
    ::-webkit-scrollbar-thumb { background: #bbf7d0; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #86efac; }

    .nav-collapsed .nav-text,
    .nav-collapsed .section-label { display: none !important; }
    .nav-collapsed .nav-item { justify-content: center; padding-left: 0; padding-right: 0; }
    .nav-collapsed { width: 5rem !important; }
  </style>
</head>
<body class="bg-white text-slate-800 min-h-screen flex flex-col overflow-x-hidden antialiased">

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toastContainer" class="fixed top-16 right-4 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full px-4"></div>

  <!-- INITIAL MANDATORY SIGN-IN / SIGN-UP GATE -->
  <div id="appAuthGate" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/20 backdrop-blur-sm p-4">
    <div class="bg-white border border-emerald-200 rounded-2xl p-6 max-w-md w-full shadow-2xl space-y-5">
      <div class="text-center space-y-2">
        <div class="inline-flex p-3 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-2xl shadow-sm">
          <i class="fa-solid fa-scale-balanced text-3xl"></i>
        </div>
        <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">ScaleGuard Enterprise Terminal</h2>
        <p class="text-xs text-slate-600">Sign in with your corporate credentials or create a new account to begin.</p>
      </div>

      <!-- Mode Switcher Tabs -->
      <div class="grid grid-cols-2 bg-emerald-50/70 p-1 rounded-xl border border-emerald-200 text-xs font-semibold">
        <button type="button" id="gateTabSignin" onclick="switchAuthGateMode('signin')" class="py-2 rounded-lg bg-emerald-600 text-white transition shadow-sm">Sign In</button>
        <button type="button" id="gateTabSignup" onclick="switchAuthGateMode('signup')" class="py-2 rounded-lg text-slate-600 hover:text-slate-900 transition">Create Account</button>
      </div>

      <!-- SIGN-IN FORM (EMAIL & PASSWORD) -->
      <form id="gateSigninForm" onsubmit="handleGateSignIn(event)" class="space-y-4">
        <div>
          <label class="block text-[11px] text-slate-600 mb-1 font-medium">Corporate Email Address</label>
          <input type="email" id="gateSigninEmail" required placeholder="corp@scaleguard.com" class="w-full bg-white border border-emerald-200 focus:border-emerald-500 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 outline-none">
        </div>
        <div>
          <label class="block text-[11px] text-slate-600 mb-1 font-medium">Password</label>
          <input type="password" id="gateSigninPassword" required placeholder="••••••••" class="w-full bg-white border border-emerald-200 focus:border-emerald-500 rounded-xl px-3.5 py-2.5 text-xs text-slate-900 mono outline-none">
          <p id="gateSigninError" class="text-[11px] text-rose-600 mt-1.5 hidden text-center font-medium">Invalid email or password. Please try again.</p>
        </div>
        <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center justify-center space-x-2">
          <i class="fa-solid fa-right-to-bracket"></i>
          <span>Sign In & Launch</span>
        </button>
      </form>

      <!-- SIGN-UP / CREATE ACCOUNT FORM -->
      <form id="gateSignupForm" onsubmit="handleGateSignUp(event)" class="space-y-3.5 hidden">
        <div>
          <label class="block text-[11px] text-slate-600 mb-1 font-medium">Corporate Email Address (Notification Target)</label>
          <input type="email" id="gateSignupEmail" required placeholder="corp@scaleguard.com" class="w-full bg-white border border-emerald-200 focus:border-emerald-500 rounded-xl px-3 py-2 text-xs text-slate-900 outline-none">
        </div>
        <div>
          <label class="block text-[11px] text-slate-600 mb-1 font-medium">Create Password</label>
          <input type="password" id="gateSignupPassword" required placeholder="••••••••" class="w-full bg-white border border-emerald-200 focus:border-emerald-500 rounded-xl px-3 py-2 text-xs text-slate-900 mono outline-none">
        </div>
        <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center justify-center space-x-2">
          <i class="fa-solid fa-user-plus"></i>
          <span>Create Account & Launch Terminal</span>
        </button>
      </form>
    </div>
  </div>

  <!-- HEADER BAR -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-emerald-100 px-4 py-3 flex items-center justify-between shadow-sm">
    <div class="flex items-center space-x-3">
      <button onclick="toggleDrawer()" class="p-2 text-slate-600 hover:text-slate-900 rounded-lg hover:bg-emerald-50 transition md:hidden" title="Toggle Navigation">
        <i class="fa-solid fa-bars text-lg"></i>
      </button>
      <div class="flex items-center space-x-2.5">
        <div class="p-2 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl">
          <i class="fa-solid fa-scale-balanced text-xl"></i>
        </div>
        <div>
          <h1 class="text-base font-extrabold text-slate-900 tracking-tight leading-none flex items-center gap-2">
            ScaleGuard <span class="text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded font-mono font-semibold">ENTERPRISE</span>
          </h1>
          <p class="text-[11px] text-slate-500 font-medium leading-tight mt-0.5" id="storeDisplayName">Organizational Terminal</p>
        </div>
      </div>
    </div>

    <!-- Right Header Controls -->
    <div class="flex items-center space-x-3">
      <!-- System Notification Center Button -->
      <button onclick="openNotificationCenterModal()" class="relative p-2 bg-white hover:bg-emerald-50 border border-emerald-200 rounded-xl text-slate-700 hover:text-slate-900 transition text-xs flex items-center gap-1.5 shadow-sm" title="System Notification Center">
        <i class="fa-solid fa-bell text-emerald-600"></i>
        <span class="hidden sm:inline">Alerts</span>
        <span id="notificationBadgeCount" class="absolute -top-1 -right-1 px-1.5 py-0.2 bg-rose-600 text-white rounded-full text-[9px] font-bold hidden">0</span>
      </button>

      <div class="hidden sm:flex items-center space-x-2 bg-emerald-50/70 border border-emerald-200 px-3 py-1.5 rounded-xl text-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="text-emerald-800 font-medium" id="headerScaleStatus">Enterprise Network Online</span>
      </div>

      <div class="hidden sm:block text-xs text-slate-600 mono" id="clockDisplay">00:00:00</div>

      <!-- Organizational Profile Shortcut Button -->
      <div id="authHeaderUser" class="flex items-center space-x-2 pl-2 border-l border-emerald-100">
        <div class="w-8 h-8 rounded-xl bg-emerald-600 text-white font-bold flex items-center justify-center text-xs shadow-sm cursor-pointer" id="orgHeaderAvatar" onclick="openProfileModal()">
          SG
        </div>
        <div class="hidden lg:block text-left cursor-pointer" onclick="openProfileModal()">
          <div class="text-xs font-bold text-slate-900 leading-tight" id="orgNameDisplay">ScaleGuard Corp</div>
          <div class="text-[10px] text-emerald-600 leading-tight" id="orgTierDisplay">Enterprise Tier</div>
        </div>
        <button onclick="openProfileModal()" class="text-slate-600 hover:text-emerald-600 p-1.5 rounded-lg hover:bg-emerald-50 transition text-xs" title="Organizational Profile Hub">
          <i class="fa-solid fa-building-shield"></i>
        </button>
        <button onclick="openSignInModal()" class="text-slate-600 hover:text-emerald-600 p-1.5 rounded-lg hover:bg-emerald-50 transition text-xs" title="Authenticate Terminal">
          <i class="fa-solid fa-user-lock"></i>
        </button>
        <button onclick="logoutOwner()" class="text-slate-600 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition text-xs" title="Lock Terminal">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </button>
      </div>
    </div>
  </header>

  <div class="flex flex-1 relative overflow-hidden">

    <!-- OVERLAY FOR MOBILE NAVIGATION -->
    <div id="drawerOverlay" onclick="toggleDrawer()" class="fixed inset-0 bg-slate-900/20 z-20 hidden md:hidden backdrop-blur-sm"></div>

    <!-- COLLAPSIBLE NAVIGATION HUB -->
    <aside id="navDrawer" class="fixed md:static inset-y-0 left-0 z-30 w-64 bg-white border-r border-emerald-100 flex flex-col justify-between transition-all duration-300 ease-in-out shrink-0 -translate-x-full md:translate-x-0 shadow-sm">
      <div class="p-3 space-y-4 overflow-y-auto">
        
        <!-- Navigation Header & Collapse Arrow Button -->
        <div class="flex items-center justify-between px-2 pt-1 pb-2 border-b border-emerald-100">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 nav-text">Enterprise Hub</span>
          <button onclick="toggleCollapseNav()" class="p-1.5 text-slate-500 hover:text-slate-900 rounded-lg hover:bg-emerald-50 transition hidden md:flex items-center justify-center" title="Collapse / Expand Menu">
            <i id="collapseIcon" class="fa-solid fa-chevron-left text-xs transition-transform duration-300"></i>
          </button>
        </div>

        <!-- NAVIGATION SECTIONS -->
        <nav class="space-y-6">

          <!-- SECTION: HOME -->
          <div class="space-y-1">
            <div class="section-label text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 px-3 pt-1 pb-1">
              Overview
            </div>
            
            <a href="#" onclick="switchView('home')" id="nav-home" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium bg-emerald-600 text-white transition shadow-sm whitespace-nowrap" title="Enterprise Welcome Home">
              <i class="fa-solid fa-house text-base shrink-0"></i>
              <span class="nav-text">Welcome Home</span>
            </a>
          </div>
          
          <!-- SECTION 1: POINT OF SALE OPERATIONS -->
          <div class="space-y-1">
            <div class="section-label text-[10px] font-extrabold uppercase tracking-wider text-emerald-700 px-3 pt-1 pb-1 flex items-center justify-between">
              <span>1. Point of Sale Operations</span>
              <span class="px-1.5 py-0.5 text-[9px] bg-emerald-100 text-emerald-800 rounded font-bold">PRIMARY</span>
            </div>
            
            <a href="#" onclick="switchView('pos')" id="nav-pos" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="Barcode Counter POS Register">
              <i class="fa-solid fa-barcode text-base shrink-0 text-emerald-600"></i>
              <span class="nav-text">Barcode Counter POS</span>
            </a>

            <a href="#" onclick="switchView('dashboard')" id="nav-dashboard" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="Real-Time Register Metrics">
              <i class="fa-solid fa-chart-line text-base shrink-0 text-emerald-600"></i>
              <span class="nav-text">Real-Time Register Metrics</span>
            </a>
          </div>

          <!-- SECTION 2: INVENTORY & SYSTEM AUDIT -->
          <div class="space-y-1">
            <div class="section-label text-[10px] font-extrabold uppercase tracking-wider text-slate-500 px-3 pt-1 pb-1">
              2. Inventory & System Audit
            </div>

            <a href="#" onclick="switchView('inventory')" id="nav-inventory" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="Product Goods Catalog">
              <i class="fa-solid fa-boxes-stacked text-base shrink-0 text-emerald-600"></i>
              <span class="nav-text">Product Goods Catalog</span>
            </a>

            <a href="#" onclick="switchView('receipt-designer')" id="nav-receipt-designer" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="Thermal Receipt Customizer">
              <i class="fa-solid fa-receipt text-base shrink-0 text-emerald-600"></i>
              <span class="nav-text">Receipt Designer</span>
            </a>

            <a href="#" onclick="switchView('scalescore')" id="nav-scalescore" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="ScaleScore Inventory">
              <i class="fa-solid fa-chart-pie text-base shrink-0 text-emerald-600"></i>
              <span class="nav-text">ScaleScore Inventory</span>
            </a>

            <a href="#" onclick="switchView('stock-audit')" id="nav-stock-audit" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="Stock Activity Audit Doc">
              <i class="fa-solid fa-file-invoice text-base shrink-0 text-emerald-600"></i>
              <span class="nav-text">Stock Activity Audit</span>
            </a>

            <a href="#" onclick="switchView('expansion')" id="nav-expansion" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="Feature Expansion Suite">
              <i class="fa-solid fa-cubes text-base shrink-0 text-emerald-600"></i>
              <span class="nav-text">Feature Expansion Suite</span>
            </a>

            <a href="#" onclick="switchView('settings')" id="nav-settings" class="nav-item flex items-center space-x-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-emerald-50/70 transition whitespace-nowrap" title="System Settings">
              <i class="fa-solid fa-gear text-base shrink-0 text-slate-500"></i>
              <span class="nav-text">System Settings</span>
            </a>
          </div>

        </nav>
      </div>

      <!-- Drawer Footer -->
      <div class="p-3 border-t border-emerald-100 text-center nav-text">
        <p class="text-[10px] text-slate-400 font-medium">ScaleGuard Enterprise v3.5</p>
      </div>
    </aside>

    <!-- MAIN CONTENT VIEWPORT -->
    <main class="flex-1 overflow-y-auto p-4 md:p-6 lg:p-8 bg-white">
      <div class="max-w-7xl mx-auto space-y-6">

        <!-- ==================== VIEW: HOME (WELCOME HOMEPAGE) ==================== -->
        <section id="view-home" class="space-y-6">
          <!-- Hero Banner Card -->
          <div class="bg-gradient-to-r from-emerald-50 via-white to-emerald-50 border border-emerald-200 p-8 rounded-3xl shadow-sm space-y-6 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="space-y-3 max-w-xl">
              <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">
                <i class="fa-solid fa-circle-check text-emerald-600"></i> Enterprise Terminal Online
              </div>
              <h2 class="text-3xl font-black text-slate-900 tracking-tight">Welcome to ScaleGuard Enterprise Hub</h2>
              <p class="text-sm text-slate-600 leading-relaxed">
                Your centralized point-of-sale, real-time inventory tracking, and stock auditing suite. Manage SKUs, monitor reorder thresholds, and process register checkouts with total precision.
              </p>
              <div class="pt-2 flex flex-wrap items-center justify-center md:justify-start gap-3">
                <button onclick="switchView('pos')" class="px-5 py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center space-x-2">
                  <i class="fa-solid fa-barcode"></i>
                  <span>Launch Counter POS</span>
                </button>
                <button onclick="switchView('inventory')" class="px-5 py-3 bg-white hover:bg-emerald-50 text-slate-700 border border-emerald-200 rounded-xl text-xs font-bold transition shadow-sm flex items-center space-x-2">
                  <i class="fa-solid fa-boxes-stacked text-emerald-600"></i>
                  <span>Manage Catalog Goods</span>
                </button>
              </div>
            </div>

            <div class="p-6 bg-white border border-emerald-200 rounded-2xl shadow-sm flex flex-col items-center justify-center space-y-3 min-w-[220px]">
              <div class="p-4 bg-emerald-50 text-emerald-600 rounded-2xl border border-emerald-200">
                <i class="fa-solid fa-scale-balanced text-4xl"></i>
              </div>
              <div class="text-center">
                <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Active System Status</div>
                <div class="text-sm font-extrabold text-emerald-600 mt-0.5">Fully Operational</div>
              </div>
            </div>
          </div>

          <!-- Quick Navigation / Feature Cards Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            
            <div onclick="switchView('pos')" class="bg-white border border-emerald-200 p-6 rounded-2xl shadow-sm hover:border-emerald-400 transition cursor-pointer space-y-3 group">
              <div class="flex items-center justify-between">
                <div class="p-3 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl group-hover:scale-105 transition">
                  <i class="fa-solid fa-barcode text-lg"></i>
                </div>
                <span class="text-xs font-bold text-emerald-600">Primary Module →</span>
              </div>
              <h3 class="text-base font-bold text-slate-900">Barcode Counter POS</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Scan barcodes or enter items manually with strict stock limit enforcement and instant cart totals.</p>
            </div>

            <div onclick="switchView('inventory')" class="bg-white border border-emerald-200 p-6 rounded-2xl shadow-sm hover:border-emerald-400 transition cursor-pointer space-y-3 group">
              <div class="flex items-center justify-between">
                <div class="p-3 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl group-hover:scale-105 transition">
                  <i class="fa-solid fa-boxes-stacked text-lg"></i>
                </div>
                <span class="text-xs font-bold text-emerald-600">Secure Vault →</span>
              </div>
              <h3 class="text-base font-bold text-slate-900">Product Goods Catalog</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Organize product SKUs, capacities, custom units of measurement, tax rates, and security passkeys.</p>
            </div>

            <div onclick="switchView('dashboard')" class="bg-white border border-emerald-200 p-6 rounded-2xl shadow-sm hover:border-emerald-400 transition cursor-pointer space-y-3 group">
              <div class="flex items-center justify-between">
                <div class="p-3 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl group-hover:scale-105 transition">
                  <i class="fa-solid fa-chart-line text-lg"></i>
                </div>
                <span class="text-xs font-bold text-emerald-600">Analytics →</span>
              </div>
              <h3 class="text-base font-bold text-slate-900">Real-Time Metrics</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Inspect gross sales volume, total item checkouts, and dropdown quick-lists of registered stock.</p>
            </div>

            <div onclick="switchView('receipt-designer')" class="bg-white border border-emerald-200 p-6 rounded-2xl shadow-sm hover:border-emerald-400 transition cursor-pointer space-y-3 group">
              <div class="flex items-center justify-between">
                <div class="p-3 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl group-hover:scale-105 transition">
                  <i class="fa-solid fa-receipt text-lg"></i>
                </div>
                <span class="text-xs font-bold text-emerald-600">Customizer →</span>
              </div>
              <h3 class="text-base font-bold text-slate-900">Thermal Receipt Designer</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Customize receipt typography, headers, dynamic tax aggregations, and paper slip aesthetics.</p>
            </div>

            <div onclick="switchView('scalescore')" class="bg-white border border-emerald-200 p-6 rounded-2xl shadow-sm hover:border-emerald-400 transition cursor-pointer space-y-3 group">
              <div class="flex items-center justify-between">
                <div class="p-3 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl group-hover:scale-105 transition">
                  <i class="fa-solid fa-chart-pie text-lg"></i>
                </div>
                <span class="text-xs font-bold text-emerald-600">Alerts →</span>
              </div>
              <h3 class="text-base font-bold text-slate-900">ScaleScore Inventory</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Monitor stock reorder levels and trigger automated email alerts when thresholds are reached.</p>
            </div>

            <div onclick="switchView('stock-audit')" class="bg-white border border-emerald-200 p-6 rounded-2xl shadow-sm hover:border-emerald-400 transition cursor-pointer space-y-3 group">
              <div class="flex items-center justify-between">
                <div class="p-3 bg-emerald-50 text-emerald-600 border border-emerald-200 rounded-xl group-hover:scale-105 transition">
                  <i class="fa-solid fa-file-invoice text-lg"></i>
                </div>
                <span class="text-xs font-bold text-emerald-600">Audit →</span>
              </div>
              <h3 class="text-base font-bold text-slate-900">Stock Activity Audit Ledger</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Filter stock movement and checkout transaction ledgers across custom date ranges with CSV export.</p>
            </div>

          </div>
        </section>

        <!-- ==================== VIEW: BARCODE COUNTER POS ==================== -->
        <section id="view-pos" class="space-y-6 hidden">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-emerald-200 shadow-sm">
            <div>
              <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <i class="fa-solid fa-barcode text-emerald-600"></i>
                Point of Sale Counter Register
              </h2>
              <p class="text-xs text-slate-600 mt-1">Scan item barcodes or enter SKUs. System strictly enforces available stock limits and alerts on reorder levels.</p>
            </div>
            
            <div class="flex items-center space-x-2">
