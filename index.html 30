    window.initHardwareBarcodeScanner = function() {
      document.addEventListener('keydown', function(event) {
        if (!isScannerConnected) return;

        const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
        const activeId = document.activeElement ? document.activeElement.id : '';

        if (activeTag === 'input' && activeId !== 'posBarcodeEntry') {
          return;
        }

        if (event.key === 'Enter') {
          if (barcodeBuffer.length > 2) {
            const cleanBarcode = barcodeBuffer.replace(/[^a-zA-Z0-9\-_]/g, '').trim();
            processScannedBarcode(cleanBarcode);
          }
          barcodeBuffer = '';
          if (barcodeTimer) clearTimeout(barcodeTimer);
          return;
        }

        if (event.key.length === 1) {
          barcodeBuffer += event.key;
          if (barcodeTimer) clearTimeout(barcodeTimer);
          barcodeTimer = setTimeout(() => {
            barcodeBuffer = '';
          }, 50);
        }
      });
    };

    window.processScannedBarcode = function(skuCode) {
      if (!skuCode || !isScannerConnected) return;

      const qtyInput = document.getElementById('posQtyEntry');
      const scanQty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

      const item = catalogGoods.find(g => g.sku.toLowerCase() === skuCode.toLowerCase());

      if (item) {
        const currentRemaining = item.remainingStock !== undefined ? item.remainingStock : item.totalStock;
        if (scanQty > currentRemaining) {
          showToast(`Sale impossible! Requested ${scanQty} units, but only ${currentRemaining} remaining in stock.`, 'error');
          window.pushSystemNotification('Stock Limit Exceeded', `Attempted order of ${scanQty} units for ${item.name} (${item.size || ''}), but only ${currentRemaining} available.`);
          return;
        }

        const existingInCart = activeCart.find(c => c.sku.toLowerCase() === skuCode.toLowerCase() && c.size === item.size);
        if (existingInCart) {
          if (existingInCart.qty + scanQty > currentRemaining) {
            showToast(`Cannot add more. Total in cart exceeds remaining stock (${currentRemaining}).`, 'warning');
            return;
          }
          existingInCart.qty += scanQty;
        } else {
          activeCart.push({
            sku: item.sku,
            name: item.name,
            size: item.size || 'Standard',
            capacity: item.capacity || 'N/A',
            uom: item.uom,
            unitPrice: item.unitPrice,
            taxRate: item.taxRate !== undefined ? item.taxRate : 8.0,
            qty: scanQty
          });
        }
        localStorage.setItem('sg_active_cart', JSON.stringify(activeCart));
        playScanAudio();
        showToast(`Scanned: ${item.name} (${scanQty} units)`, 'success');
        
        const posEntry = document.getElementById('posBarcodeEntry');
        if (posEntry) posEntry.value = '';
        if (qtyInput) qtyInput.value = '1';
        
        window.renderPosCart();
      } else {
        showToast(`Unrecognized Barcode / SKU: ${skuCode}`, 'error');
      }
    };

