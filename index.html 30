      tbody.innerHTML = '';
      let totalUnits = 0;
      let totalVal = 0;

      if (activeCart.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-slate-400 font-medium">No items scanned yet. Use attached scanner or enter SKU above.</td></tr>`;
      } else {
        activeCart.forEach(item => {
          const itemTotal = item.qty * item.unitPrice;
          totalUnits += item.qty;
          totalVal += itemTotal;
          tbody.innerHTML += `
            <tr class="hover:bg-emerald-50/40">
              <td class="py-2.5 px-3"><div class="font-bold text-slate-900">${item.name} [${item.size}]</div><div class="text-[10px] text-slate-500">Cap: ${item.capacity} | Tax: ${item.taxRate !== undefined ? item.taxRate : 8.0}%</div></td>
              <td class="py-2.5 px-3 text-center font-bold mono">${item.qty} ${item.uom}</td>
              <td class="py-2.5 px-3 text-right mono">${currencySymbol}${item.unitPrice.toFixed(2)}</td>
              <td class="py-2.5 px-3 text-right font-extrabold text-emerald-600 mono">${currencySymbol}${itemTotal.toFixed(2)}</td>
            </tr>`;
        });
      }
      if (unitsEl) unitsEl.innerText = `${totalUnits} units`;
      if (valEl) valEl.innerText = `${currencySymbol}${totalVal.toFixed(2)}`;
    };

    window.renderCatalogTable = function() {
      const tbody = document.getElementById('catalogTableBody');
      if (!tbody) return;
      tbody.innerHTML = '';
