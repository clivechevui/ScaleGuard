        const qtyInput = document.getElementById('posQtyEntry');
        const scanQty = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

        if (item) {
          const currentRemaining = item.remainingStock !== undefined ? item.remainingStock : item.totalStock;
          if (scanQty > currentRemaining) {
            showToast(`Sale impossible! Requested ${scanQty} units, but only ${currentRemaining} available in inventory.`, 'error');
            window.pushSystemNotification('Stock Limit Exceeded', `Attempted sale of ${scanQty} units for ${item.name} (${item.size || ''}), but only ${currentRemaining} available.`);
            return;
          }

          const existingInCart = activeCart.find(c => c.sku.toLowerCase() === skuVal.toLowerCase() && c.size === item.size);
          if (existingInCart) {
            if (existingInCart.qty + scanQty > currentRemaining) {
              showToast(`Cannot add more. Exceeds remaining stock (${currentRemaining}).`, 'warning');
              return;
            }
            existingInCart.qty += scanQty;
          } else {
            activeCart.push({
              sku: item.sku,
              name: item.name,
              size: item.size || 'Standard',
              capacity: item.capacity || 'N/A',
              uom: item.uom,
              unitPrice: item.unitPrice,
              taxRate: item.taxRate !== undefined ? item.taxRate : 8.0,
