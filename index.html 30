    window.clearPosCart = function() {
      activeCart = [];
      localStorage.setItem('sg_active_cart', JSON.stringify(activeCart));
      window.renderPosCart();
      showToast('Register cleared.', 'info');
    };

    window.finalizePosTransaction = function() {
      if (activeCart.length === 0) {
        showToast('Cart is empty. Scan items first.', 'warning');
        return;
      }

      let lowStockAlerts = [];

      activeCart.forEach(item => {
        const itemTotal = item.qty * item.unitPrice;
        stockAuditLogs.unshift({
          timestamp: new Date().toLocaleString(),
          sku: item.sku,
          name: `${item.name} [${item.size}]`,
          qty: item.qty,
          type: 'POS Scan Checkout',
          totalVal: itemTotal
        });

        const catalogItem = catalogGoods.find(g => g.sku === item.sku && g.size === item.size);
        if (catalogItem) {
          const currentRem = catalogItem.remainingStock !== undefined ? catalogItem.remainingStock : catalogItem.totalStock;
          catalogItem.remainingStock = Math.max(0, currentRem - item.qty);

          if (catalogItem.remainingStock <= catalogItem.reorderPoint) {
            lowStockAlerts.push(`${catalogItem.name} (${catalogItem.size}) remaining stock is ${catalogItem.remainingStock} (Reorder threshold: ${catalogItem.reorderPoint})`);
          }
        }
      });

      localStorage.setItem('sg_catalog', JSON.stringify(catalogGoods));
      localStorage.setItem('sg_audit_logs', JSON.stringify(stockAuditLogs));

      if (lowStockAlerts.length > 0) {
        lowStockAlerts.forEach(alertMsg => {
          window.pushSystemNotification('REORDER LEVEL REACHED', alertMsg);
        });
        showToast('Reorder threshold alert triggered & sent to email!', 'warning');
      }

      openThermalReceiptModal();
      activeCart = [];
      localStorage.setItem('sg_active_cart', JSON.stringify(activeCart));
      window.renderAll();
      showToast('Transaction finalized successfully!', 'success');
    };

    window.exportCurrentReceipt = function() {
      window.print();
    };

    window.printAuditDocument = function() {
      window.print();
    };

    window.exportAuditCSV = function() {
      if (stockAuditLogs.length === 0) {
        showToast('No audit logs available to export.', 'warning');
        return;
      }
      let csvContent = "data:text/csv;charset=utf-8,Date/Time,SKU,Item Name,Quantity,Type,Total Value\n";
      stockAuditLogs.forEach(l => {
        csvContent += `"${l.timestamp}","${l.sku}","${l.name}",${l.qty},"${l.type}",${l.totalVal}\n`;
      });
      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute("download", `scaleguard_audit_${Date.now()}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showToast('Exported CSV successfully!', 'success');
    };

    window.saveSettings = function() {
      const nameInput = document.getElementById('settingsStoreName');
      const currInput = document.getElementById('settingsCurrency');
      const notifEmailInput = document.getElementById('settingsNotificationEmail');
      const footerInput = document.getElementById('settingsReceiptFooter');
      const lockInput = document.getElementById('settingsAutoLock');
      const keyInput = document.getElementById('settingsSecurityKey');
      const keyConfirmInput = document.getElementById('settingsSecurityKeyConfirm');
      const mismatchErr = document.getElementById('passkeyMismatchError');

      if (mismatchErr) mismatchErr.classList.add('hidden');

      if (keyInput && keyInput.value.trim()) {
        const newKey = keyInput.value.trim();
        const confirmKey = keyConfirmInput ? keyConfirmInput.value.trim() : '';
        if (newKey !== confirmKey) {
          if (mismatchErr) mismatchErr.classList.remove('hidden');
          showToast('Security keys do not match!', 'error');
          return;
        }
        securityPasskey = newKey;
        keyInput.value = '';
        if (keyConfirmInput) keyConfirmInput.value = '';
      }

      if (nameInput) {
        orgProfile.name = nameInput.value.trim() || 'ScaleGuard Corp';
        localStorage.setItem('sg_org_profile', JSON.stringify(orgProfile));
      }
      if (currInput) currencySymbol = currInput.value;
      if (notifEmailInput && notifEmailInput.value.trim()) {
        notificationEmail = notifEmailInput.value.trim();
        localStorage.setItem('sg_notif_email', notificationEmail);
        orgProfile.email = notificationEmail;
        localStorage.setItem('sg_org_profile', JSON.stringify(orgProfile));
      }
      if (footerInput) receiptFooterText = footerInput.value.trim();
      if (lockInput) autoLockMinutes = lockInput.value;

      localStorage.setItem('sg_passkey', securityPasskey);
      localStorage.setItem('sg_currency', currencySymbol);
      localStorage.setItem('sg_receipt_footer', receiptFooterText);
      localStorage.setItem('sg_autolock', autoLockMinutes);

      showToast('Enterprise Configurations & Email Settings Saved!', 'success');
      window.renderAll();
